# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://tjqldcvlcbxhbvovhmmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by the Shopify connector (credential storage, sync,
# webhooks, cron). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used for auth email redirects (magic link, confirm).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI (any OpenAI-compatible provider) ─────────────────────────────────────
# Leave AI_API_KEY empty to run the deterministic demo AI (no network calls).
#
# Default: Google Gemini (OpenAI-compatible endpoint)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_VISION_MODEL=gemini-2.5-flash
#
# Alternative: Qwen (Alibaba Cloud DashScope, international)
# AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=sk-...
# AI_MODEL=qwen-max
# AI_VISION_MODEL=qwen-vl-max

# ─── Shopify connector ───────────────────────────────────────────────────────
# 32-byte key for AES-256-GCM encryption of Shopify secrets/tokens at rest.
# Generate with: openssl rand -base64 32   (changing it invalidates saved connections)
STOREOS_ENCRYPTION_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/shopify-sync.
CRON_SECRET=
# Optional app-level credentials for OAuth installs started without entering them in Settings.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional; defaults to $NEXT_PUBLIC_SITE_URL/api/shopify/callback (must match the Dev Dashboard).
SHOPIFY_REDIRECT_URI=
